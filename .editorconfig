root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json}]
indent_size = 2
trim_trailing_whitespace = false

[*.cs]
# Language conventions
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_style_readonly_field = true:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

# Naming: nothing but English identifiers is enforceable here, but these keep the
# shape consistent. The binding source for domain names is 03-SLOWNIK-POJEC.md.
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# Silence is forbidden (CLAUDE.md rule 8): an empty catch block is an error,
# not a style preference.
dotnet_diagnostic.CA1031.severity = warning

# ---------------------------------------------------------------------------------------
# Analysers turned on one rule at a time, 2026-08-02, after measuring what a mode costs.
#
# AnalysisMode=Recommended was measured on this tree and reported 496 warnings, of which
# 248 were CA1707 - "identifiers should not contain underscores" - which is every test
# name in the project and a deliberate convention. A guard that screams at correct code
# gets switched off in a week, so a mode is the wrong instrument here and a named list is
# the right one. Every rule below earned its place by what it found or by what it protects.
#
# What the measurement also showed, and it is worth writing down because it deflates the
# reason this was proposed: none of these would have caught the reentrancy hole in the
# window. Analysers see patterns, not designs.

# Dispose before losing scope. This one found a real leak on the day it went in: a
# certificate context per signed file, 544 of them in one snapshot, left to a finaliser.
# No test could have seen it - the answers were right and the run finished.
dotnet_diagnostic.CA2000.severity = warning

# Culture. Rule 3 of CLAUDE.md says never assume an English Windows, and these are that
# rule where a compiler can check it: a comparison or a conversion that quietly depends on
# the machine's regional settings is exactly the silent wrong answer this product cannot
# afford. The invariant forms have to be asked for out loud.
dotnet_diagnostic.CA1304.severity = warning
dotnet_diagnostic.CA1305.severity = warning
dotnet_diagnostic.CA1307.severity = warning
dotnet_diagnostic.CA1310.severity = warning

# Blocking inside something asynchronous, and awaiting without saying which context it
# comes back on. Neither fires today - the window already writes ConfigureAwait everywhere
# and nothing blocks - so these are here to keep it that way rather than to fix anything.
# A tick running once a second on the interface thread is where the first Result or Wait
# would freeze the window, and it would look like the machine being slow.
dotnet_diagnostic.CA1849.severity = warning
dotnet_diagnostic.CA2007.severity = warning

# A cancellation token that exists and is not passed on. Background work that cannot be
# stopped is half of what 06-STRUKTURA-I-KONWENCJE part 4 asks for.
dotnet_diagnostic.CA2016.severity = warning

# ---------------------------------------------------------------------------------------
# Meziantou.Analyzer, 2026-08-02. Measured before choosing, like the mode above.
#
# Turned on with everything reported and then narrowed to three rules. The counts below are
# what the whole set produced on this tree, halved because a build lists each warning twice.
#
# KEPT, with what each one is for:
#   MA0051  method too long. This is the anti-tangle ceiling the file ratchet cannot give -
#           a file can pass its limit while holding one method nobody can read. Configured
#           at today's worst rather than at a nice round number, so it ratchets like the
#           file one: the number may only ever fall.
#   MA0009  a regular expression with no timeout. Nine hits, all in guards reading our own
#           files, and NONE in the product - because the query language already compiles
#           user patterns on the non-backtracking engine with a ceiling. That is the point:
#           the day somebody adds a pattern over typed input without one, this fires.
#   MA0011  TryParse without a format provider. One hit, and it is rule 3 of CLAUDE.md
#           where a compiler can check it.
#
# TURNED OFF, with the measured reason - not because they are wrong, because here they
# would be a guard screaming at correct code:
dotnet_diagnostic.MA0002.severity = none   # 127 hits: a comparer on every dictionary of strings, where ordinal is already what is meant
dotnet_diagnostic.MA0048.severity = none   # 66 hits: file name must match type name. Small related types share a file here on purpose
dotnet_diagnostic.MA0006.severity = none   # 40 hits: string.Equals over ==, which is ordinal already and reads worse
dotnet_diagnostic.MA0023.severity = none   # 4 hits: explicit capture groups, a performance nicety with no correctness in it
dotnet_diagnostic.MA0004.severity = none   # 4 hits: overlaps CA2007, which is already on for the product only
dotnet_diagnostic.MA0016.severity = none   # a collection abstraction where the concrete type is the point
dotnet_diagnostic.MA0047.severity = none   # a type outside a namespace: ExitCode sits beside a top level program on purpose
dotnet_diagnostic.MA0008.severity = none   # struct layout on interop shapes the generator already lays out

dotnet_diagnostic.MA0051.severity = warning
dotnet_diagnostic.MA0009.severity = warning
dotnet_diagnostic.MA0011.severity = warning

# The ratchet dial. Set at the longest method standing today, which is how the file ceilings
# were set - and like them it may only ever go down.
MA0051.maximum_lines_per_method = 120
#
# Two methods are suppressed at the declaration rather than covered by raising this number,
# and the difference matters: raising it would hide everything between here and there.
#   QueryFields.BuildAll  - a table, one declaration per field, no branching. Splitting it
#                           would put the language's field list in several places.
#   CommandLine.Read      - 199 lines, and the analyser is right. Written down as backlog
#                           item 24 rather than refactored on the way past.

[tests/**.cs]
# The one rule above that does not apply here rather than being inconvenient. CA2007 is
# about which context an await comes back on, and the test runner has none - so writing
# ConfigureAwait on every await in a test would be ceremony that says nothing. Everything
# else stays on: a test comparing strings against what the machine returned is subject to
# the same regional settings the product is.
dotnet_diagnostic.CA2007.severity = none
