# Rendered by packaging/build-feeds.ps1 - do not edit the generated copy.
# yaml-language-server: $schema=https://aka.ms/winget-manifest.installer.{{WINGET_SCHEMA}}.schema.json

PackageIdentifier: {{WINGET_ID}}
PackageVersion: {{VERSION}}
ReleaseDate: {{RELEASE_DATE}}
# Windows 10 1809 and Windows Server 2019, the oldest Windows the README promises.
MinimumOSVersion: 10.0.17763.0
InstallerType: zip
NestedInstallerType: portable
NestedInstallerFiles:
- RelativeFilePath: {{CLI_ZIP_EXE}}
# WinGet then makes no link in its own links folder and puts the folder bws is
# in on PATH instead (PortableInstaller.cpp in winget-cli, read by the sibling
# project 2026-11-02). That folder holds bws, its licence and its notices and
# nothing else. Without the field WinGet would make a link named bws.exe, and
# the WinGet package of Bitwarden Secrets Manager CLI makes one of that name
# too (PortableCommandAlias: bws, read 2026-11-03).
ArchiveBinariesDependOnPath: true
Commands:
- bws
Installers:
- Architecture: x64
  InstallerUrl: {{CLI_ZIP_URL}}
  InstallerSha256: {{CLI_ZIP_SHA256}}
ManifestType: installer
ManifestVersion: {{WINGET_SCHEMA}}
