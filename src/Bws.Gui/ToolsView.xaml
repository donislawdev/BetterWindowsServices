<UserControl x:Class="Bws.Gui.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:gui="clr-namespace:Bws.Gui"
             Focusable="False"
             IsTabStop="False">

    <!--
        THE TOOLS TAB - `docs/PROJEKT-TOOLS-20261020.md`, owner's decisions T-a to T-h of 2026-10-20. Ready-made
        answers to problems somebody has, named the way they would name the problem.

        A PAGE OF ITS OWN, NOT A VIEW IN THE MIDDLE: the window takes the search, the filters and the actions
        away while it is up (MainWindow.ArrangeTheChrome), so nothing over it speaks about a list. The bar of
        tabs stays, which is how somebody gets back.

        SECTIONS AND CARDS COME FROM A LIST, NOT FROM MARKUP (GUI rule 8). A section per tool in the
        catalogue the command line reads too, and in it a card per item - ToolsPage builds both, and this
        file only draws them. A tool added to the catalogue arrives here without an edit.

        Read from the top like a document, not centred like the overview's poster: this page will grow
        sections, and a block that re-centres itself every time one is added is a page that moves.

        Bound to the whole model, like the overview, and for the same reason: the cards ask the reading
        whether their entry exists. Focusable and IsTabStop are off for the reason `docs/10` trap 8 gives.
    -->
    <UserControl.Resources>
        <gui:TilesAcross x:Key="CardsAcross" />

        <!--
            ONE CARD. A button with the card's face, so the whole card is one tab stop and one click. Its
            name for a screen reader is the problem and its help text the tooltip - what will open, or why
            nothing can. ShowOnDisabled because a card that cannot be pressed has to say why (`docs/10`
            trap 14). What pressing opens is decided in the window: the ordinary plan sheet, nothing else.
        -->
        <DataTemplate x:Key="ToolCardTemplate">
            <Button Style="{StaticResource ToolCard}"
                    AutomationProperties.Name="{Binding Title}"
                    AutomationProperties.HelpText="{Binding Hint}"
                    ToolTip="{Binding Hint}"
                    ToolTipService.ShowOnDisabled="True"
                    IsEnabled="{Binding Available}"
                    Click="CardPressed">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource ToolTitleText}" />

                    <TextBlock Text="{Binding What}" Style="{StaticResource ToolWhatText}" />

                    <TextBlock Text="{Binding Effect}"
                               TextWrapping="Wrap"
                               Margin="{StaticResource MarginTileParts}"
                               Style="{StaticResource SubduedText}" />

                    <TextBlock Text="{Binding Command}" Style="{StaticResource ToolCommandText}" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <!--
            ONE SECTION: the tool's name, one sentence about it, and its cards in as many columns as the
            width allows - the overview's TilesAcross, the same converter and the same least card width,
            so a card is never narrower here than there.
        -->
        <DataTemplate x:Key="ToolSectionTemplate">
            <StackPanel Margin="{StaticResource MarginSection}">
                <TextBlock Text="{Binding Heading}" Style="{StaticResource SectionHeadingText}" />

                <TextBlock Text="{Binding What}"
                           TextWrapping="Wrap"
                           MaxWidth="{StaticResource WidthOverview}"
                           HorizontalAlignment="Left"
                           Margin="{StaticResource MarginTileLabel}"
                           Style="{StaticResource SubduedText}" />

                <ItemsControl ItemsSource="{Binding Cards}"
                              ItemTemplate="{StaticResource ToolCardTemplate}"
                              Focusable="False"
                              Margin="{StaticResource MarginTileParts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <primitives:UniformGrid>
                                <primitives:UniformGrid.Columns>
                                    <MultiBinding Converter="{StaticResource CardsAcross}"
                                                  ConverterParameter="{StaticResource WidthOverviewCardLeast}">
                                        <Binding Path="ViewportWidth"
                                                 RelativeSource="{RelativeSource AncestorType=ScrollViewer}" />
                                        <Binding Path="Items.Count"
                                                 RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                    </MultiBinding>
                                </primitives:UniformGrid.Columns>
                            </primitives:UniformGrid>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroll"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="{StaticResource WidthOverviewFindings}"
                    HorizontalAlignment="Left"
                    Margin="{StaticResource PadPanel}">

            <TextBlock AutomationProperties.AutomationId="toolsTitle"
                       Text="{DynamicResource gui.tools.title}"
                       Style="{StaticResource HeadingText}" />

            <TextBlock Text="{DynamicResource gui.tools.what}"
                       TextWrapping="Wrap"
                       MaxWidth="{StaticResource WidthOverview}"
                       HorizontalAlignment="Left"
                       Margin="{StaticResource MarginAboveStatus}"
                       Style="{StaticResource BodyText}" />

            <!--
                The AutomationId on the ItemsControl and not on a panel: WPF builds an automation peer for
                controls, not for layout panels - the lesson ScopeBar.xaml records as paid five times.
            -->
            <ItemsControl AutomationProperties.AutomationId="toolsSections"
                          AutomationProperties.Name="{DynamicResource gui.tools.title}"
                          Focusable="False"
                          ItemsSource="{Binding Tabs.Tools.Sections}"
                          ItemTemplate="{StaticResource ToolSectionTemplate}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
