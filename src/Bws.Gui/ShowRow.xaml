<UserControl x:Class="Bws.Gui.ShowRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             IsTabStop="False">

    <!--
        WHICH ROWS OF A TABLE ARE ON SCREEN - a button with a menu, the way Columns opens its own, rather
        than a drop-down list this window has nowhere else. Owner's decision W2-b of 2026-10-15 for the
        comparison, and J2-b of 2026-10-20 for the change history, which is why this is ONE component
        bound to a ViewModels.IRowChoices rather than a file per table (GUI rules 2 and 5). Beside the
        button, how many rows are on screen while a choice hides some - rule 8.

        A COMPONENT OF ITS OWN FROM THE START, GUI rule 9: it has its own state (the choices) and its own
        controls. It was DiffFilterRow until the second table needed it.

        THE MARGIN ABOVE IS ON THE PANEL, NOT ON THIS CONTROL, so the row takes its gap with it when
        there is nothing to narrow and the table gives way to a sentence.

        The automation names come from the table that uses it (Named, in the code behind), so a probe
        asks for "diffShow" or "historyShow" and never for a button it cannot tell apart from another.

        Focusable and IsTabStop are off because a UserControl is both by default - `docs/10` trap 8.
    -->
    <StackPanel Orientation="Horizontal"
                Margin="{StaticResource MarginTileParts}">
        <StackPanel.Style>
            <Style TargetType="StackPanel">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Offered}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </StackPanel.Style>

        <Button x:Name="ShowButton"
                Content="{Binding Button}"
                ToolTip="{Binding Hint}"
                Margin="{StaticResource MarginBetweenControls}"
                Click="ShowAsked">
            <Button.ContextMenu>
                <ContextMenu x:Name="ShowMenu"
                             MaxHeight="{StaticResource HeightMenu}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </Button.ContextMenu>
        </Button>

        <TextBlock x:Name="ShowingText"
                   Text="{Binding Showing}"
                   VerticalAlignment="Center"
                   Style="{StaticResource SubduedText}" />
    </StackPanel>
</UserControl>
