<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:media="clr-namespace:System.Windows.Media;assembly=PresentationCore">

    <!--
        THE HELP THE SEARCH BOX GIVES, 2026-11-17 - the owner's three choices of 2026-11-16 for the
        query language: the searches made lately over the questions, a button at the end of the box
        opening a guide, and a mark under a mistake (that one is MistakeMarks.cs, drawn in code).

        A FILE OF ITS OWN BECAUSE THE TWO IT BELONGS BESIDE ARE FULL ENOUGH: SearchField.xaml stood
        at 110 lines and Suggestions.xaml at 88 against a crowd line of 123 (the markup ratchet).
        The seam is a subject - what helps somebody write a query - rather than a count.

        MERGED BEFORE Suggestions.xaml, because the list's row and item templates there name the
        clock and the group heading declared here. Nothing here names anything from that file.
    -->

    <!--
        THE CLOCK BESIDE A SEARCH MADE LATELY - the sign every search box on Windows puts beside its
        history, so a row in the fixed face with a clock reads as "you typed this" without a word.
        Drawn rather than taken from an icon font, for the reason SearchMark gives: Segoe Fluent
        Icons is not on Windows Server. A ring and two hands on a 14 unit square (SizeQueryHelpMark),
        in the hint's colour.
    -->
    <Style x:Key="RecentMark" TargetType="Path">
        <Setter Property="Stroke" Value="{StaticResource TextSubdued}" />
        <Setter Property="StrokeThickness" Value="{StaticResource ShapeOutline}" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="Width" Value="{StaticResource SizeQueryHelpMark}" />
        <Setter Property="Height" Value="{StaticResource SizeQueryHelpMark}" />
        <Setter Property="Margin" Value="{StaticResource MarginRecentMark}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Data" Value="M 7,1 A 6,6 0 1 1 6.99,1 M 7,3.8 L 7,7 L 9.4,8.4" />
    </Style>

    <!--
        THE NAME OF A GROUP OF ROWS THAT DOES NOT OPEN THE LIST - "Questions to start from" under the
        searches made lately. Over its row, outside the part of the row that lights up, and it takes
        no clicks, so pointing at it lights nothing and pressing it writes nothing. The rule above it
        is the one between the list and its keys, so the two groups read as two.
    -->
    <Style x:Key="SuggestionHeading" TargetType="Border">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="BorderBrush" Value="{StaticResource SurfacePanelEdge}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderFooterRule}" />
        <Setter Property="Padding" Value="{StaticResource PadCell}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Heading}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        THE BUTTON AT THE END OF THE SEARCH BOX THAT OPENS THE GUIDE. Inside the frame, so it reads as
        part of the field. It never takes the keyboard: the guide is the list under the box, and that
        list closes the moment the box loses the keyboard - so the button puts the keyboard in the box
        and asks for the guide, and F1 in the box does the same. Named for automation in the view.
    -->
    <Style x:Key="SearchGuideButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Margin" Value="{StaticResource MarginSearchGuideButton}" />
        <Setter Property="Padding" Value="{StaticResource PadSearchGuideButton}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face"
                            Background="{x:Static media:Brushes.Transparent}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <Path x:Name="Mark"
                              Stroke="{StaticResource TextSubdued}"
                              StrokeThickness="{StaticResource ShapeOutline}"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="{StaticResource SizeQueryHelpMark}"
                              Height="{StaticResource SizeQueryHelpMark}"
                              Data="M 7,1 A 6,6 0 1 1 6.99,1 M 5.1,5.4 A 1.9,1.9 0 1 1 7.6,7.2 C 7.1,7.5 7,7.9 7,8.6 M 7,10.6 L 7,10.7" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource SurfaceHover}" />
                            <Setter TargetName="Mark" Property="Stroke" Value="{StaticResource TextOnSurface}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        THE FIELDS UNDER THE EXAMPLES IN THE GUIDE, with the rule the list draws over its keys above
        them, so they read as the next part. Only while the list is the guide.
    -->
    <Style x:Key="GuideBlock" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource PadCell}" />
        <Setter Property="BorderBrush" Value="{StaticResource SurfacePanelEdge}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderFooterRule}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Suggesting.Guiding}" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The line over the fields. -->
    <Style x:Key="GuideFieldsLabel" TargetType="TextBlock" BasedOn="{StaticResource SubduedText}">
        <Setter Property="Margin" Value="{StaticResource MarginGuideFieldsLabel}" />
    </Style>

    <!--
        ONE FIELD OF THE LANGUAGE, WRITTEN INTO THE BOX BY A CLICK - the filter chip's pill, because a
        rounded outline on this window means "press this", in the fixed face, because it is a word
        of the language rather than a sentence. It never takes the keyboard, for the reason the
        button above gives. Pointed at, it lights in the hover surface FOR THE PANEL - the window's
        reads 1.30 on this surface (Suggestions.xaml, SuggestionItem).
    -->
    <Style x:Key="GuideField" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource TextOnSurface}" />
        <Setter Property="Padding" Value="{StaticResource PadGuideField}" />
        <Setter Property="Margin" Value="{StaticResource MarginChip}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Pill"
                            Background="{x:Static media:Brushes.Transparent}"
                            BorderBrush="{StaticResource SurfaceChipEdge}"
                            BorderThickness="{StaticResource BorderAllSides}"
                            CornerRadius="{StaticResource CornerChip}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{StaticResource SurfaceHoverOnPanel}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
