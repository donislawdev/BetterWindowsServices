<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        WHAT THE PLAN SHEET LOOKS LIKE AROUND A RUN: the buttons that start one, stop one and close
        the sheet after one, and the result at the top once there is one. Styles only, not one value.

        ITS OWN FILE SINCE 2026-11-16, AND THE MARKUP RATCHET IS WHAT ASKED, for the third time on
        this sheet. The finished sheet got a result block and a button of its own that day, Plan.xaml
        would have climbed into the crowd standing near the ceiling of markup, and the foot of the
        sheet already had. What went here is one subject - the run - so the sheet itself stays in
        Plan.xaml, what a line of a plan looks like in PlanLines.xaml, and this merges after both,
        because the button that carries a plan out wears TrimmedButtonLabel from Plan.xaml.
    -->

    <!--
        THE LINE UNDER THE HEADING, AND ONCE THERE IS A RESULT A BLOCK - 2026-11-16, on the owner's
        words that the finished sheet did not read as done. Before a run, and during one, it is the
        bare sentence it always was. With a result it takes the rule every block on this sheet takes,
        in the colour of the outcome, and PlanResultMark beside the words says it a second way.

        THE SAME RULE AS THE OTHER BLOCKS AND NO FILL, for the reason PanelBlock gives in Plan.xaml: a
        fill is a new surface that every colour on it has to clear again. What makes this one loud is
        the mark and the place - the first thing under the heading - not a heavier stroke.
    -->
    <Style x:Key="PlanResult" TargetType="Border">
        <Setter Property="Margin" Value="{StaticResource MarginBelowSearch}" />

        <Style.Triggers>
            <DataTrigger Binding="{Binding Outcome}" Value="Arrived">
                <Setter Property="BorderBrush" Value="{StaticResource MeaningArrived}" />
                <Setter Property="BorderThickness" Value="{StaticResource BorderPanelEdge}" />
                <Setter Property="Padding" Value="{StaticResource PadCell}" />
            </DataTrigger>

            <DataTrigger Binding="{Binding Outcome}" Value="FellShort">
                <Setter Property="BorderBrush" Value="{StaticResource MeaningWarning}" />
                <Setter Property="BorderThickness" Value="{StaticResource BorderPanelEdge}" />
                <Setter Property="Padding" Value="{StaticResource PadCell}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        THE MARK OF A RESULT - a tick in a ring, or an exclamation in the same ring, both stroked in
        the colour of the rule beside them. Gone until there is a result. Drawn at its own size on the
        square its geometry was drawn for, so nothing is scaled - Values.xaml, ShapeResultArrived.
    -->
    <Style x:Key="PlanResultMark" TargetType="Path">
        <Setter Property="Width" Value="{StaticResource SizeResultMark}" />
        <Setter Property="Height" Value="{StaticResource SizeResultMark}" />
        <Setter Property="StrokeThickness" Value="{StaticResource ShapeOutline}" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Margin" Value="{StaticResource MarginAfterShape}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Visibility" Value="Collapsed" />

        <Style.Triggers>
            <DataTrigger Binding="{Binding Outcome}" Value="Arrived">
                <Setter Property="Visibility" Value="Visible" />
                <Setter Property="Data" Value="{StaticResource ShapeResultArrived}" />
                <Setter Property="Stroke" Value="{StaticResource MeaningArrived}" />
            </DataTrigger>

            <DataTrigger Binding="{Binding Outcome}" Value="FellShort">
                <Setter Property="Visibility" Value="Visible" />
                <Setter Property="Data" Value="{StaticResource ShapeResultFellShort}" />
                <Setter Property="Stroke" Value="{StaticResource MeaningWarning}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        THE BUTTON THAT CARRIES A PLAN OUT. A name is unbounded and the row is not, so it stops
        growing at WidthCarryOutMost and its word is trimmed with an ellipsis - the heading carries the
        whole name. ShowOnDisabled because the tooltip says why it is grey, and WPF serves no tooltip
        to a disabled control otherwise.

        IT GOES ONCE THERE IS A RESULT, since 2026-11-16. It stood greyed under a finished report,
        still naming the act it had just done, and read as a button waiting for something. PlanDone
        takes its cell.
    -->
    <Style x:Key="PlanCarryOut" TargetType="Button" BasedOn="{StaticResource DestructiveAction}">
        <Setter Property="ContentTemplate" Value="{StaticResource TrimmedButtonLabel}" />
        <Setter Property="MaxWidth" Value="{StaticResource WidthCarryOutMost}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />

        <Style.Triggers>
            <DataTrigger Binding="{Binding HasResult}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        THE WAY OUT OF A FINISHED SHEET, 2026-11-16 - the owner chose it over a greyed copy of the
        button that had just run. Blue, because closing is now the main thing to do here and red means
        "this changes your machine". The same words as the close mark in the corner, which does the
        same thing.
    -->
    <Style x:Key="PlanDone" TargetType="Button" BasedOn="{StaticResource PrimaryAction}">
        <Setter Property="Content" Value="{DynamicResource gui.plan.close}" />
        <Setter Property="ToolTip" Value="{DynamicResource gui.plan.close.hint}" />
        <Setter Property="Visibility" Value="Collapsed" />

        <Style.Triggers>
            <DataTrigger Binding="{Binding HasResult}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        THE TWO BUTTONS THAT EXIST ONLY WHILE A RUN GOES - Interrupt, and the second way of stopping.
        Both grey once pressed and both say why on the tooltip, so both need ShowOnDisabled, and both
        keep the gap before the button to their right. Named on 2026-11-16 because the same three
        lines stood on both - GUI rule 7.
    -->
    <Style x:Key="PlanRunButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Margin" Value="{StaticResource MarginBetweenControls}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    </Style>
</ResourceDictionary>
