<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        WHAT THE SETTINGS PAGE IS BUILT FROM - `docs/PROJEKT-USTAWIENIA-20261117.md`. Styles only, and not one
        value of its own: every brush, size and margin points at a name the rest of the window already uses,
        the way Tools.xaml does it.

        A SETTING IS A CARD, THE OVERVIEW'S CARD. The same fill, edge, corner and padding as the overview's
        and the Tools page's, because three pages of cards should not look like three products (GUI rule 2).
        Not pressable, unlike a Tools card: a setting holds controls, and a card that is also a button would
        put a second click target around every one of them.

        STACKED, NOT TWO COLUMNS. The title and the sentence about a setting stand above its controls rather
        than beside them. A translated sentence is longer than the English one, and a column of controls on
        the right would take its width from that sentence at every language - GUI rule 14, the layout is
        worked out rather than measured.
    -->

    <!-- One setting. The overview's card, stacked one under another with the tile gap between them. -->
    <Style x:Key="SettingsCard" TargetType="Border" BasedOn="{StaticResource OverviewCard}">
        <Setter Property="Margin" Value="{StaticResource MarginTileParts}" />
    </Style>

    <!--
        WHAT THE SETTING IS, at the top of its card. The Tools card's title: the header size with the weight
        of a heading, named here rather than borrowed so the two can part later without either noticing.
        The size is written out for the reason Tools.xaml gives - TypeScaleGuards asks a style that sets the
        weight to name its size.
    -->
    <Style x:Key="SettingTitleText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontSize" Value="{StaticResource TextSizeHeader}" />
        <Setter Property="FontWeight" Value="{StaticResource TextWeightHeader}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- What it does, under the title - the Tools card's sentence. -->
    <Style x:Key="SettingWhatText" TargetType="TextBlock" BasedOn="{StaticResource BodySubduedText}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="{StaticResource MarginTileLabel}" />
    </Style>

    <!--
        ONE LANGUAGE TO CHOOSE. The library's own radio button with this window's face, the way the implicit
        CheckBox style in Controls.xaml wears it - a list of choices of one, which a screen reader meets as one
        group and the arrow keys move through without a line of ours. Keyed rather than implicit, because the
        tabs across the top are radio buttons too and wear a look of their own.
    -->
    <Style x:Key="LanguageOption" TargetType="RadioButton" BasedOn="{StaticResource DefaultRadioButtonStyle}">
        <Setter Property="FontFamily" Value="{StaticResource TextFace}" />
        <Setter Property="FontSize" Value="{StaticResource TextSizeNormal}" />
        <Setter Property="Margin" Value="{StaticResource MarginTileLabel}" />
    </Style>

    <!--
        A SWITCH IN A CARD, starting where the text above it starts. The library's check box carries a padding
        of 11,5,11,6 around its box and the radio button carries none - read from their templates with
        tools/wpfui-probe (probe template DefaultCheckBoxStyle) on 2026-11-17, after the first picture showed the
        box eleven points to the right of the title over it. GUI rule 19: everything in a card lines up.
    -->
    <Style x:Key="SettingCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Padding" Value="{StaticResource PadNone}" />
        <Setter Property="Margin" Value="{StaticResource MarginAboveStatus}" />
    </Style>

    <!--
        A FACT THE WINDOW HAS TO SAY ABOUT A CHOICE - the language Windows asks for and this window does not
        have, or the change that waits for the next start. Ordinary text rather than a warning colour: nothing
        is wrong, the window is saying what it will do.
    -->
    <Style x:Key="SettingNoteText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="{StaticResource MarginAboveStatus}" />
    </Style>

    <!--
        WHERE THE FILE IS, in the fixed face every path and command in this window wears. Wrapped, because a
        profile path is as long as the account name in it and nothing here may cut it in half.
    -->
    <Style x:Key="SettingPathText" TargetType="TextBlock" BasedOn="{StaticResource FixedText}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="{StaticResource MarginTileLabel}" />
    </Style>

    <!-- A button inside a card, below what it acts on - the library's button, pushed off the text above it. -->
    <Style x:Key="SettingButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="{StaticResource MarginAboveStatus}" />
    </Style>
</ResourceDictionary>
