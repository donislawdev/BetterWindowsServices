<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        THE VERBS OVER THE LIST - the look of a button that asks for a plan which would change the
        machine, and the mark that says carrying it out needs administrator rights.

        A FILE OF ITS OWN SINCE 2026-09-23, arriving with UX-GUI-004 (b). Controls.xaml stood two
        lines under the markup ceiling, and these two styles are one idea: the six write buttons of
        the action bar and the one thing they wear that the other buttons do not.

        MERGED AFTER Controls.xaml, because WriteAction extends the implicit Button style, which is
        reachable from that point on - the same rule Menus.xaml states about MenuItem.
    -->

    <!--
        A SHIELD, THE MARK WINDOWS PUTS ON A BUTTON THAT NEEDS ADMINISTRATOR RIGHTS. Drawn the way
        the heart on Donate is drawn (SupportMark in Controls.xaml) and for its two measured reasons:
        a Path rather than a character, because a glyph needs a font that carries it on Windows
        Server and a TextBlock gets a node of its own in the automation tree - and the fill follows
        the button's own foreground, so the shield greys with a disabled button instead of standing
        out on it. One colour rather than Windows' blue and yellow: the window's palette has no
        colour that means "rights" and this is not the place to add one.

        SHOWN ONLY WHILE THE BAR SAYS SO. The bar is told once by the window, from the session's
        rights, and a bar nobody told draws no shield - the catalogue's plain cells are that bar.
    -->
    <Style x:Key="RightsMark" TargetType="Path">
        <Setter Property="Fill"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="{StaticResource GapAfterRightsMark}" />
        <Setter Property="Width" Value="{StaticResource SizeRightsMark}" />
        <Setter Property="Height" Value="{StaticResource SizeRightsMark}" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Data"
                Value="M 4,0.3 L 7.6,1.6 L 7.6,4 C 7.6,6.1 6,7.3 4,7.8 C 2,7.3 0.4,6.1 0.4,4 L 0.4,1.6 Z" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding NeedsRights, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        A BUTTON THAT OPENS A PLAN WHICH WOULD CHANGE THE MACHINE - six of them in the action bar,
        which until 2026-09-23 each wrote out the same two attributes. GUI rule 7: the second time a
        look is written it gets a name, and the shield is the third thing they share.

        ShowOnDisabled because every one of them says on itself why it is off - WPF serves no
        tooltip to a disabled control otherwise (`docs/10` trap 14). The label stays the button's
        content, so the name a screen reader and every probe read is still "Stop..." - the shield
        has no node of its own, and the tooltip says in words what it means.
    -->
    <Style x:Key="WriteAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Margin" Value="{StaticResource MarginBetweenControls}" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource RightsMark}" />
                        <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- The shield takes most of the left padding rather than adding its width - Values.xaml says why. -->
            <DataTrigger Binding="{Binding NeedsRights, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                <Setter Property="Padding" Value="{StaticResource PadButtonWithMark}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
