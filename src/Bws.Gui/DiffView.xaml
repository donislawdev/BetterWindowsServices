<UserControl x:Class="Bws.Gui.DiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Bws.Gui"
             Focusable="False"
             IsTabStop="False">

    <!--
        WHAT DIFFERS BETWEEN TWO SIDES - `D2` in the window, since 2026-10-14 (`docs/PROJEKT-DRUGA-
        POLOWA-AUDYTU-20261014.md`, W1 for a snapshot against this machine, W2 for two snapshots).
        Bound to a ViewModels.DiffSheet, worked out once when the comparison arrives: a comparison is
        a statement about two moments that have both passed, so nothing here is kept in step with the
        machine. Which sides were compared reaches this view only as the words the sheet hands it.

        IN PLACE OF THE LIST, LIKE THE OVERVIEW - owner's decision W-b. The window collapses the list's
        own controls while this is up (MainWindow.Overview.cs, ArrangeTheChrome), because the search
        box, the filters and the action bar all act on a list that is not on screen.

        WHAT MAKES THE COMPARISON LESS THAN EXACT GOES ABOVE THE TABLE, not under it - the command
        line's reason: somebody who reads the differences first has already believed something.

        Focusable and IsTabStop are off because a UserControl IS a ContentControl and a ContentControl
        is both by default - `docs/10` trap 8.
    -->
    <Grid Margin="{StaticResource PadPanel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            THE TITLE, THE EXPORT AND THE WAY BACK SHARE A LINE, the overview's arrangement and its
            reason: the exit must not depend on the height of anything below it, and the top is the one
            place that holds at every size. The export sits there for the same reason - it is about the
            whole comparison, sentences and all (W2-c), not about the table under it.
        -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       AutomationProperties.AutomationId="diffTitle"
                       Text="{Binding Title}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Style="{StaticResource HeadingText}" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="ExportButton"
                        AutomationProperties.AutomationId="diffExport"
                        Content="{DynamicResource gui.diff.export}"
                        ToolTip="{DynamicResource gui.diff.export.hint}"
                        Margin="{StaticResource MarginBetweenControls}"
                        Click="Export" />

                <Button x:Name="BackButton"
                        AutomationProperties.AutomationId="diffBack"
                        Content="{DynamicResource gui.diff.back}"
                        ToolTip="{DynamicResource gui.diff.back.hint}"
                        Style="{StaticResource PrimaryAction}"
                        Click="Back" />
            </StackPanel>
        </Grid>

        <!--
            THE SIDES, ONE OR TWO: which snapshot, from which machine, when, by whom and with what
            rights - and its note when it carries one, collapsed rather than empty, because an empty
            line still spends its margin. A list from the sheet rather than two copies of the same pair
            of lines (GUI rule 8).
        -->
        <ItemsControl Grid.Row="1"
                      AutomationProperties.AutomationId="diffSides"
                      ItemsSource="{Binding Sides}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock AutomationProperties.AutomationId="diffAbout"
                                   Text="{Binding About}"
                                   TextWrapping="Wrap"
                                   MaxWidth="{StaticResource WidthOverview}"
                                   HorizontalAlignment="Left"
                                   Margin="{StaticResource MarginAboveStatus}"
                                   Style="{StaticResource BodyText}" />

                        <TextBlock AutomationProperties.AutomationId="diffNote"
                                   Text="{Binding Note}"
                                   TextWrapping="Wrap"
                                   MaxWidth="{StaticResource WidthOverview}"
                                   HorizontalAlignment="Left"
                                   Margin="{StaticResource MarginAboveStatus}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SubduedText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Note}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Grid.Row="2"
                   AutomationProperties.AutomationId="diffCounts"
                   Text="{Binding Counts}"
                   TextWrapping="Wrap"
                   Margin="{StaticResource MarginAboveStatus}"
                   Style="{StaticResource BodyText}" />

        <!--
            THE CAVEATS, IN THE NOTICE VOICE - the colour the line under the list uses for what an
            answer has to admit about itself, which is what each of these is. The AutomationId is on the
            ItemsControl, never on a panel: a layout panel gets no automation peer. No choice under
            "Show" hides these - they are not rows.
        -->
        <ItemsControl Grid.Row="3"
                      AutomationProperties.AutomationId="diffCaveats"
                      ItemsSource="{Binding Caveats}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               TextWrapping="Wrap"
                               Margin="{StaticResource MarginAboveStatus}"
                               Style="{StaticResource NoticeText}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Which rows the table shows, "Show" and its count - DiffFilterRow.xaml (W2-b). -->
        <local:DiffFilterRow Grid.Row="4"
                             x:Name="Choices" />

        <!-- The table, or the sentence in its place when nothing differs - DiffTable.xaml. -->
        <local:DiffTable Grid.Row="5"
                         x:Name="Table"
                         Margin="{StaticResource MarginTileParts}" />
    </Grid>
</UserControl>
