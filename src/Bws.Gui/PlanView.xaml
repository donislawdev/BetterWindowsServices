<UserControl x:Class="Bws.Gui.PlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Bws.Gui"
             Focusable="False"
             IsTabStop="False">

    <!--
        WHAT AN OPERATION OVER THE SELECTION WOULD DO - the window's dry run, packet 2 of `S7`. A
        UserControl in its own file, for the criterion the details panel established: a theme file
        describes the look of ONE CONTROL, and a part of the window lives beside MainWindow.xaml.

        IT STOPPED BEING A COLUMN AND BECAME A SHEET ON 2026-09-02, on the owner's decision, and it
        no longer shares anything with the details panel - it covers the window. The two are still
        mutually exclusive and the window still closes one to open the other. Why a sheet and what
        it costs are beside PlanSheet in Themes/Plan.xaml, and the argument is in `docs/11` 3.12.

        IT HAS NO WIDTH OF ITS OWN ANY MORE - it used to carry 380, then 440 because everything in
        it wrapped. Now it fills its cell and the sheet inside takes what it needs.

        Focusable and IsTabStop are off because a UserControl is a ContentControl and arrives with
        both - `docs/10` trap 8. Hit testing stays ON: this holds a button somebody has to press,
        and the scrim has to eat the clicks the list behind it must not receive.
    -->

    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed" />

            <Style.Triggers>
                <!--
                    Collapsed rather than hidden, so the column gives its width back to the list
                    while nobody is looking at a plan - the same reason the details panel collapses.
                -->
                <DataTrigger Binding="{Binding Showing}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <UserControl.Resources>
        <!--
            THE THREE TEMPLATES THAT WERE HERE WENT TO Themes/Plan.xaml ON 2026-09-02, and the
            ratchet is what asked: this file stood EXACTLY on the 376-line ceiling, so the redesign
            the owner asked for could not add a line until something came out. What went is what a
            step, a sentence and a command LOOK like. What stays is what this panel IS.

            The converter cannot follow them, and that is a rule rather than an oversight: a styles
            file may hold a Style or a DataTemplate and nothing else, so a value declared there is
            one nobody reading the value files would find. AppearanceGuards holds that whitelist.
        -->
        <!-- One converter for six sections, and it is the framework's own. -->
        <BooleanToVisibilityConverter x:Key="WhenTrue" />
    </UserControl.Resources>

    <!--
        TWO LAYERS AND THE ORDER MATTERS: the dimming first so it lies under, the sheet second so it
        lies on top. Both fill this control, which fills the whole window - see MainWindow.xaml,
        where this stopped being a cell in the grid on 2026-09-02 and became a layer over all of it.
    -->
    <Grid>
        <Border Style="{StaticResource PlanScrim}" />

        <!--
            NAMED SINCE 2026-09-07, because backlog 278 is a question about THIS rectangle: at
            1000 by 800 the sheet once ran past the window and cut the main button in half. The
            confirmation box grows the footer, so the height of this is the number that had to be
            measured rather than estimated - see the guard that reads it.

            THE WIDTH IS A NAME SINCE 2026-09-15 and was a raw 560 here for a fortnight - the same
            family as backlog 352, a dimension written where no guard reads it. The number did not
            move, only where it lives.
        -->
        <Border x:Name="Sheet" Style="{StaticResource PlanSheet}" Width="{StaticResource WidthPlanSheet}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--
                    TWO NAMES, THE SAME PAIR THE DETAILS PANEL ALREADY SHOWS - the display name as
                    the title, the manager's own name under it. `ADR-14` is why the second may never
                    be dropped: display names are translated, so a panel carrying only that names
                    nothing anybody could act on. The line disappears rather than emptying - backlog
                    203.
                -->
                <StackPanel Grid.Column="0" Margin="{StaticResource MarginGroup}">
                    <TextBlock x:Name="PlanHeading"
                               AutomationProperties.AutomationId="planHeading"
                               Text="{Binding Heading}"
                               TextWrapping="Wrap"
                               Style="{StaticResource PlanTitleText}" />

                    <!--
                        THE MANAGER'S OWN NAME IN THE FIXED FACE SINCE 2026-09-02: this is the
                        string somebody TYPES, so one wrong character is a different service - the
                        argument the command block at the foot of this panel already won. It was
                        SubduedText, twelve points of grey measuring 4.76 on this panel's own
                        surface, so the one name `ADR-14` says anybody can act on was the smallest
                        and faintest thing here.
                    -->
                    <TextBlock x:Name="PlanSubtitle"
                               Margin="{StaticResource MarginTileLabel}"
                               AutomationProperties.AutomationId="planSubtitle"
                               Text="{Binding Subtitle}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Subtitle}"
                               Visibility="{Binding HasSubtitle, Converter={StaticResource WhenTrue}}"
                               Style="{StaticResource FixedText}" />
                </StackPanel>

                <!--
                    The visible way out, beside Escape which is the fast one - Nielsen's third
                    heuristic. Why it is a mark rather than the word is beside PlanClose in
                    Themes/Plan.xaml, with the measurement.

                    IT KEEPS ITS NAME BY BEING GIVEN ONE: a button whose content is a shape has no
                    text to take a name from, and three instruments read that tree by name.
                -->
                <!--
                    NAMED SINCE 2026-09-07, because it is where the keyboard goes when a sheet that
                    can end a process opens without a box to type into. See PlanView.WayIn.
                -->
                <Button Grid.Column="1"
                        x:Name="PlanCloseButton"
                        Style="{StaticResource PlanClose}"
                        AutomationProperties.AutomationId="planClose"
                        AutomationProperties.Name="{DynamicResource gui.plan.close}"
                        ToolTip="{DynamicResource gui.plan.close.hint}"
                        VerticalAlignment="Top"
                        Click="CloseRequested" />
            </Grid>

            <!--
                A GAP UNDER THIS BLOCK SINCE 2026-09-02: without one the state sentence sat ON the
                rule dividing head from body. That rule belongs to the body's Border, which pads
                INSIDE itself, so the air above it has to come from here.
            -->
            <StackPanel Grid.Row="1" Margin="{StaticResource MarginBelowSearch}">
                <!--
                    WHERE THIS PANEL IS IN THE ONLY SEQUENCE IT HAS, AND IT IS STILL THE MOST
                    IMPORTANT LINE IN IT. A list of steps reads as a report of something done in
                    every one of the three states, so this line is what tells a person which one
                    they are looking at.

                    IT WORE THE WARNING ORANGE UNTIL 2026-08-19 AND THAT WAS A FAULT rather than a
                    style choice: it is the same colour as the line at the bottom of the window
                    saying the session has no administrator rights, so a sentence reporting that
                    NOTHING HAS HAPPENED read as something having gone wrong. It carries by weight
                    now, and the colour is left for the line under it, which really is a warning.
                -->
                <TextBlock x:Name="PlanNotice"
                           AutomationProperties.AutomationId="planNotice"
                           Text="{Binding Notice}"
                           TextWrapping="Wrap"
                           Style="{StaticResource PlanNoticeText}" />

            </StackPanel>

            <!--
                THE LINE ABOVE THE SCROLLING HALF, 2026-09-01, repairing what the owner called
                things running into each other: the last visible line was cut through the middle by
                the edge of the scrolling region with nothing saying an edge was there. A rule turns
                the same pixels into "there is more below". Scrolls vertically and never sideways.
            -->
            <Border Grid.Row="2"
                    BorderBrush="{StaticResource SurfacePanelEdge}"
                    BorderThickness="{StaticResource BorderFooterRule}"
                    Padding="{StaticResource PaddingFooter}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!--
                        EVERY SECTION TAKES ITS HEADING OFF THE SCREEN WITH IT, since 2026-08-19 and
                        backlog 203. A heading reading "Not included, and why" over nothing states
                        something false, and that is what the owner saw on the first look at this
                        panel. The steps carry no such switch, because a plan with no steps never
                        opens this panel at all.
                    -->
                    <!--
                        THE ONE BLOCK ON THIS PANEL THAT SAYS WHAT WOULD HAPPEN TO THE MACHINE, and
                        since 2026-09-02 a block rather than a fourth paragraph. The heading moved
                        INSIDE the rule with the steps, so the two are one object rather than a
                        label pointing at a box. The block carries MarginSection now.
                    -->
                    <Border Style="{StaticResource PlanBlock}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource gui.plan.steps}"
                                       Margin="{StaticResource MarginBelowSearch}"
                                       Style="{StaticResource SectionHeadingText}" />

                            <ItemsControl x:Name="StepList"
                                          AutomationProperties.AutomationId="planSteps"
                                          ItemsSource="{Binding Steps}"
                                          ItemTemplate="{StaticResource PlanLineTemplate}" />
                        </StackPanel>
                    </Border>

                    <TextBlock AutomationProperties.AutomationId="planExtra"
                               Text="{Binding Extra}"
                               TextWrapping="Wrap"
                               Margin="{StaticResource MarginAboveStatus}"
                               Visibility="{Binding HasExtra, Converter={StaticResource WhenTrue}}"
                               Style="{StaticResource NoticeText}" />

                    <TextBlock AutomationProperties.AutomationId="planOverlapping"
                               Text="{Binding Overlapping}"
                               TextWrapping="Wrap"
                               Margin="{StaticResource MarginAboveStatus}"
                               Visibility="{Binding HasOverlapping, Converter={StaticResource WhenTrue}}"
                               Style="{StaticResource SubduedText}" />

                    <StackPanel Visibility="{Binding HasWarnings, Converter={StaticResource WhenTrue}}">
                        <TextBlock Text="{DynamicResource gui.plan.warnings}"
                                   Margin="{StaticResource MarginSection}"
                                   Style="{StaticResource SectionHeadingText}" />

                        <ItemsControl AutomationProperties.AutomationId="planWarnings"
                                      ItemsSource="{Binding Warnings}"
                                      ItemTemplate="{StaticResource PlanSentenceTemplate}" />
                    </StackPanel>

                    <StackPanel x:Name="ProblemSection"
                                Visibility="{Binding HasProblems, Converter={StaticResource WhenTrue}}">
                        <TextBlock Text="{DynamicResource gui.plan.problems}"
                                   Margin="{StaticResource MarginSection}"
                                   Style="{StaticResource SectionHeadingText}" />

                        <ItemsControl x:Name="ProblemList"
                                      AutomationProperties.AutomationId="planProblems"
                                      ItemsSource="{Binding Problems}"
                                      ItemTemplate="{StaticResource PlanSentenceTemplate}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding HasFailures, Converter={StaticResource WhenTrue}}">
                        <TextBlock Text="{DynamicResource gui.plan.failures}"
                                   Margin="{StaticResource MarginSection}"
                                   Style="{StaticResource SectionHeadingText}" />

                        <!--
                            THE ONE SECTION WITH A WAY OUT UNDER IT, SINCE 2026-09-07. A failure
                            that can be escalated carries an offer beside its own sentence rather
                            than in the footer - `docs/11` 9.2 point 4, because a button in the
                            footer would be detached from the entry it is about, and a plan over
                            twenty rows can fail on any of them. Click is caught here for the
                            reason the commands below give: the template lives in a plain
                            dictionary with no class behind it, and the event bubbles.
                        -->
                        <ItemsControl x:Name="FailureList"
                                      AutomationProperties.AutomationId="planFailures"
                                      Button.Click="ForceRequested"
                                      ItemsSource="{Binding Failures}"
                                      ItemTemplate="{StaticResource PlanFailureTemplate}" />
                    </StackPanel>

                    <StackPanel x:Name="WayBackSection"
                                Visibility="{Binding HasWayBack, Converter={StaticResource WhenTrue}}">
                        <TextBlock Text="{DynamicResource gui.plan.wayBack}"
                                   Margin="{StaticResource MarginSection}"
                                   Style="{StaticResource SectionHeadingText}" />

                        <ItemsControl x:Name="WayBackList"
                                      AutomationProperties.AutomationId="planWayBack"
                                      ItemsSource="{Binding WayBack}"
                                      ItemTemplate="{StaticResource PlanCommandTemplate}" />
                    </StackPanel>

                    <!--
                        THE COMMAND THAT WOULD ASK FOR THE SAME THING - and it goes away once
                        something has been asked. `E5` is a part of the PREVIEW, which is why Krok 2
                        of this packet built it before anything could run: it is the plan rendered as
                        text somebody could type INSTEAD of pressing.

                        Left standing after a run it becomes the wrong command in the most prominent
                        place on the panel. The owner's screenshot of 2026-08-19 shows it under the
                        way back, so the last two lines read "to put this back: bws start Spooler"
                        and then "bws stop Spooler" - the second describing something that already
                        happened, sitting where a reader scanning upwards from the button lands
                        first.
                    -->
                    <StackPanel x:Name="CommandSection"
                                Visibility="{Binding HasCommands, Converter={StaticResource WhenTrue}}">
                        <TextBlock Text="{DynamicResource gui.plan.commands}"
                                   Margin="{StaticResource MarginSection}"
                                   Style="{StaticResource SectionHeadingText}" />

                        <ItemsControl x:Name="CommandList"
                                      AutomationProperties.AutomationId="planCommands"
                                      Button.Click="CopyCommandRequested"
                                      ItemsSource="{Binding Commands}"
                                      ItemTemplate="{StaticResource PlanCommandTemplate}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            </Border>

            <!--
                THE ASK, AND IT LEFT THIS FILE ON 2026-09-07 - see PlanFooter.xaml for what it holds
                and why the confirmation box could only ever live there. The seam is the one this
                sheet was already shaped around: the row above scrolls and is evidence, this never
                scrolls and is the question.
            -->
            <local:PlanFooter Grid.Row="3" x:Name="Footer" />
        </Grid>
        </Border>
    </Grid>
</UserControl>
