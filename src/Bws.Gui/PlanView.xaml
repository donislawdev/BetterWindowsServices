<UserControl x:Class="Bws.Gui.PlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             IsTabStop="False"
             Width="380">

    <!--
        WHAT AN OPERATION OVER THE SELECTION WOULD DO - the window's dry run, packet 2 of `S7`.

        A UserControl in its own file, for the criterion written down when the details panel met the
        same question: a theme file describes the look of ONE CONTROL, and a part of the window lives
        in its own file beside MainWindow.xaml. It declares no style of its own - every face below is
        one this window already had - so it asks the theme for no room at all.

        IT SHARES ITS COLUMN WITH THE DETAILS PANEL AND THE TWO ARE MUTUALLY EXCLUSIVE, which is a
        decision rather than a saving. The details panel is opened by Enter on one row and this by a
        menu over a selection, so they are never both the thing somebody is looking at - and a panel
        across the bottom would take rows away at every window height, which is the argument the
        details panel already carries against that shape.

        Focusable and IsTabStop are off because a UserControl is a ContentControl and arrives with
        both - `docs/10` trap 8, measured on this product. Hit testing stays ON, unlike the empty
        state, because this panel holds a button somebody has to be able to press.

        Width is a number here for the reason DetailsView gives for the same line: `ADR-23` wants
        appearance values named in the theme, the values file has no room to name one, and Width is
        not among the attributes AppearanceGuards polices. It moves into the theme with the panel next
        door, on the day backlog 173 gives that file room.
    -->

    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed" />

            <Style.Triggers>
                <!--
                    Collapsed rather than hidden, so the column gives its width back to the list
                    while nobody is looking at a plan - the same reason the details panel collapses.
                -->
                <DataTrigger Binding="{Binding Showing}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <UserControl.Resources>
        <!--
            ONE STEP. The number is part of the sentence rather than a column, because a plan is read
            as prose - "3. stop Netlogon (would break otherwise)" - and a person counting steps wants
            to see where they are in the order.

            WHAT SOMEBODY ASKED FOR READS DIFFERENTLY FROM WHAT COMES ALONG, and `C2` is why: the
            promise is that the plan warns stopping three drags in seven, so the seven have to be
            findable at a glance rather than by reading every line. Subdued for the ones nobody asked
            for, which is the quieter of the two and therefore the right way round - the entries a
            person picked are the ones they are looking for.
        -->
        <DataTemplate x:Key="PlanLineTemplate">
            <TextBlock Text="{Binding Text}"
                       TextWrapping="Wrap"
                       Margin="{StaticResource MarginBetweenControls}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource PlanStepText}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Asked}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextOnSurface}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>

        <!-- One sentence in a list of them: a warning, a refusal, or a command to paste. -->
        <DataTemplate x:Key="PlanSentenceTemplate">
            <TextBlock Text="{Binding}"
                       TextWrapping="Wrap"
                       Margin="{StaticResource MarginBetweenControls}" />
        </DataTemplate>

        <!--
            A COMMAND LINE, IN THE FIXED WIDTH FACE. `docs/03` part 4 asks for it wherever two
            different things must not be able to look the same, and a command somebody is about to
            paste into a terminal is exactly that - one wrong character is a different service.
        -->
        <DataTemplate x:Key="PlanCommandTemplate">
            <TextBlock Text="{Binding}"
                       TextWrapping="Wrap"
                       FontFamily="{StaticResource TextFaceFixed}"
                       Margin="{StaticResource MarginBetweenControls}" />
        </DataTemplate>
        <!--
            One converter for six sections, and it is the framework's own. Six style blocks with a
            DataTrigger each would say the same thing six times and take this file past the markup
            ceiling - which is exactly the room the empty state was moved out to make.
        -->
        <BooleanToVisibilityConverter x:Key="WhenTrue" />
    </UserControl.Resources>

    <!--
        THE PANEL'S OWN SURFACE, AND UNTIL 2026-08-19 IT HAD NONE. The owner looked at this panel for
        the first time and said it looks bad, and this was why: with no fill and no edge it was drawn
        straight over the list. The Account column ran underneath its first line and a selected row
        carried its blue behind the text, so nothing said the right hand side of the window was a
        different thing - which is also why the button at the bottom looked like it belonged to
        nothing at all.

        Padding as well as fill. Without it the first character sits on the edge, and the fill alone
        then fails to separate the two.
    -->
    <Border Background="{StaticResource SurfacePanel}"
            BorderBrush="{StaticResource SurfacePanelEdge}"
            BorderThickness="{StaticResource BorderPanelEdge}"
            Padding="{StaticResource PaddingPanel}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--
                    TWO NAMES, THE SAME PAIR THE DETAILS PANEL ALREADY SHOWS - the display name as
                    the title because it is the one somebody recognises, and the manager's own name
                    under it because it is the one they would type into a command. `ADR-14` is why
                    the second one may never be dropped: display names are translated, so a panel
                    carrying only that names nothing anybody could act on.

                    The line under it disappears rather than emptying, because a heading with a
                    reserved gap under it is the fault backlog 203 was written for.
                -->
                <StackPanel Grid.Column="0" Margin="{StaticResource MarginGroup}">
                    <TextBlock x:Name="PlanHeading"
                               AutomationProperties.AutomationId="planHeading"
                               Text="{Binding Heading}"
                               TextWrapping="Wrap"
                               Style="{StaticResource HeadingText}" />

                    <TextBlock x:Name="PlanSubtitle"
                               AutomationProperties.AutomationId="planSubtitle"
                               Text="{Binding Subtitle}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Subtitle}"
                               Visibility="{Binding HasSubtitle, Converter={StaticResource WhenTrue}}"
                               Style="{StaticResource SubduedText}" />
                </StackPanel>

                <!--
                    The visible way out, beside Escape which is the fast one. Nielsen's third
                    heuristic, which this product's own review names as its weakest.
                -->
                <Button Grid.Column="1"
                        AutomationProperties.AutomationId="planClose"
                        Content="{DynamicResource gui.plan.close}"
                        ToolTip="{DynamicResource gui.plan.close.hint}"
                        VerticalAlignment="Top"
                        Click="CloseRequested" />
            </Grid>

            <StackPanel Grid.Row="1">
                <!--
                    WHERE THIS PANEL IS IN THE ONLY SEQUENCE IT HAS, AND IT IS STILL THE MOST
                    IMPORTANT LINE IN IT. A list of steps reads as a report of something done in
                    every one of the three states, so this line is what tells a person which one
                    they are looking at.

                    IT WORE THE WARNING ORANGE UNTIL 2026-08-19 AND THAT WAS A FAULT rather than a
                    style choice: it is the same colour as the line at the bottom of the window
                    saying the session has no administrator rights, so a sentence reporting that
                    NOTHING HAS HAPPENED read as something having gone wrong. It carries by weight
                    now, and the colour is left for the line under it, which really is a warning.
                -->
                <TextBlock x:Name="PlanNotice"
                           AutomationProperties.AutomationId="planNotice"
                           Text="{Binding Notice}"
                           TextWrapping="Wrap"
                           Style="{StaticResource PlanNoticeText}" />

                <!--
                    WHY IT CANNOT BE CARRIED OUT HERE, SAID BEFORE ANYBODY PRESSES ANYTHING - the
                    owner's decision of 2026-08-18, which the first version of this panel did not
                    keep. It only appears when something is in the way, so no empty line is ever
                    reserved for reassurance.
                -->
                <TextBlock x:Name="PlanBlocked"
                           AutomationProperties.AutomationId="planBlocked"
                           Text="{Binding Blocked}"
                           TextWrapping="Wrap"
                           Margin="{StaticResource MarginAboveStatus}"
                           Visibility="{Binding HasBlocked, Converter={StaticResource WhenTrue}}"
                           Style="{StaticResource NoticeText}" />
            </StackPanel>

            <!-- Scrolls vertically and never sideways, so a long command wraps rather than hides. -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!--
                        EVERY SECTION TAKES ITS HEADING OFF THE SCREEN WITH IT, since 2026-08-19 and
                        backlog 203. A heading reading "Not included, and why" over nothing states
                        something false, and that is what the owner saw on the first look at this
                        panel. The steps carry no such switch, because a plan with no steps never
                        opens this panel at all.
                    -->
                    <TextBlock Text="{DynamicResource gui.plan.steps}"
                               Margin="{StaticResource MarginSection}"
                               Style="{StaticResource SectionHeadingText}" />

                    <ItemsControl x:Name="StepList"
                                  AutomationProperties.AutomationId="planSteps"
                                  ItemsSource="{Binding Steps}"
                                  ItemTemplate="{StaticResource PlanLineTemplate}" />

                    <TextBlock AutomationProperties.AutomationId="planExtra"
                               Text="{Binding Extra}"
                               TextWrapping="Wrap"
                               Margin="{StaticResource MarginAboveStatus}"
                               Visibility="{Binding HasExtra, Converter={StaticResource WhenTrue}}"
                               Style="{StaticResource NoticeText}" />

                    <TextBlock AutomationProperties.AutomationId="planOverlapping"
                               Text="{Binding Overlapping}"
                               TextWrapping="Wrap"
                               Margin="{StaticResource MarginAboveStatus}"
                               Visibility="{Binding HasOverlapping, Converter={StaticResource WhenTrue}}"
                               Style="{StaticResource SubduedText}" />

                    <StackPanel Visibility="{Binding HasWarnings, Converter={StaticResource WhenTrue}}">
                        <TextBlock Text="{DynamicResource gui.plan.warnings}"
                                   Margin="{StaticResource MarginSection}"
                                   Style="{StaticResource SectionHeadingText}" />

                        <ItemsControl AutomationProperties.AutomationId="planWarnings"
                                      ItemsSource="{Binding Warnings}"
                                      ItemTemplate="{StaticResource PlanSentenceTemplate}" />
                    </StackPanel>

                    <StackPanel x:Name="ProblemSection"
                                Visibility="{Binding HasProblems, Converter={StaticResource WhenTrue}}">
                        <TextBlock Text="{DynamicResource gui.plan.problems}"
                                   Margin="{StaticResource MarginSection}"
                                   Style="{StaticResource SectionHeadingText}" />

                        <ItemsControl x:Name="ProblemList"
                                      AutomationProperties.AutomationId="planProblems"
                                      ItemsSource="{Binding Problems}"
                                      ItemTemplate="{StaticResource PlanSentenceTemplate}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding HasFailures, Converter={StaticResource WhenTrue}}">
                        <TextBlock Text="{DynamicResource gui.plan.failures}"
                                   Margin="{StaticResource MarginSection}"
                                   Style="{StaticResource SectionHeadingText}" />

                        <ItemsControl x:Name="FailureList"
                                      AutomationProperties.AutomationId="planFailures"
                                      ItemsSource="{Binding Failures}"
                                      ItemTemplate="{StaticResource PlanSentenceTemplate}" />
                    </StackPanel>

                    <StackPanel x:Name="WayBackSection"
                                Visibility="{Binding HasWayBack, Converter={StaticResource WhenTrue}}">
                        <TextBlock Text="{DynamicResource gui.plan.wayBack}"
                                   Margin="{StaticResource MarginSection}"
                                   Style="{StaticResource SectionHeadingText}" />

                        <ItemsControl x:Name="WayBackList"
                                      AutomationProperties.AutomationId="planWayBack"
                                      ItemsSource="{Binding WayBack}"
                                      ItemTemplate="{StaticResource PlanCommandTemplate}" />
                    </StackPanel>

                    <!--
                        THE COMMAND THAT WOULD ASK FOR THE SAME THING - and it goes away once
                        something has been asked. `E5` is a part of the PREVIEW, which is why Krok 2
                        of this packet built it before anything could run: it is the plan rendered as
                        text somebody could type INSTEAD of pressing.

                        Left standing after a run it becomes the wrong command in the most prominent
                        place on the panel. The owner's screenshot of 2026-08-19 shows it under the
                        way back, so the last two lines read "to put this back: bws start Spooler"
                        and then "bws stop Spooler" - the second describing something that already
                        happened, sitting where a reader scanning upwards from the button lands
                        first.
                    -->
                    <StackPanel x:Name="CommandSection"
                                Visibility="{Binding HasCommands, Converter={StaticResource WhenTrue}}">
                        <TextBlock Text="{DynamicResource gui.plan.commands}"
                                   Margin="{StaticResource MarginSection}"
                                   Style="{StaticResource SectionHeadingText}" />

                        <ItemsControl x:Name="CommandList"
                                      AutomationProperties.AutomationId="planCommands"
                                      ItemsSource="{Binding Commands}"
                                      ItemTemplate="{StaticResource PlanCommandTemplate}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!--
                THE FOOTER, AND THE RULE ABOVE IT IS WHY THE BUTTON STOPPED LOOKING ORPHANED. It sits
                at the bottom of the panel rather than under the steps, which is right - `docs/11`
                9.2 wants the effect shown before the ask, and a way to say yes that has to be
                scrolled to is one somebody presses without reaching the end. What was missing was
                anything joining it to the panel: with no fill and no rule it was a button floating
                in the dark half a screen away from the plan it acts on.

                INTERRUPT IS A SEPARATE BUTTON RATHER THAN THIS ONE CHANGING ITS WORD, and that is a
                safety decision. A button whose verb changes under a finger turns a double click into
                an instruction nobody gave. It appears to the LEFT and grows into the progress line,
                so the rectangle a person aimed at never becomes something else - it becomes disabled.
            -->
            <Border Grid.Row="3"
                    BorderBrush="{StaticResource SurfacePanelEdge}"
                    BorderThickness="{StaticResource BorderFooterRule}"
                    Padding="{StaticResource PaddingFooter}"
                    Margin="{StaticResource MarginAboveStatus}">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               x:Name="PlanProgress"
                               AutomationProperties.AutomationId="planProgress"
                               Text="{Binding Progress}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Style="{StaticResource SubduedText}" />

                    <Button Grid.Column="1"
                            x:Name="InterruptButton"
                            AutomationProperties.AutomationId="planInterrupt"
                            Content="{DynamicResource gui.plan.interrupt}"
                            ToolTip="{DynamicResource gui.plan.interrupt.hint}"
                            Margin="{StaticResource MarginBetweenControls}"
                            Visibility="{Binding Busy, Converter={StaticResource WhenTrue}}"
                            Click="InterruptRequested" />

                    <!--
                        THE TOOLTIP SAYS WHY IT IS GREY, AND ShowOnDisabled IS WHAT MAKES THAT
                        REACHABLE AT ALL. WPF stops serving tooltips for a disabled control, so the
                        reason bound below would be a sentence nobody could ever read without this
                        line - a control refusing without a reason, which is what it was.

                        Bound rather than a fixed key, because the button has four ways of going
                        quiet and only one of them was ever said out loud. What it says when nothing
                        is in the way is the same sentence as before, chosen in CarryOutTip.
                    -->
                    <Button Grid.Column="2"
                            x:Name="CarryOutButton"
                            AutomationProperties.AutomationId="planCarryOut"
                            Content="{DynamicResource gui.plan.carryOut}"
                            ToolTip="{Binding CarryOutTip}"
                            ToolTipService.ShowOnDisabled="True"
                            IsEnabled="{Binding CanCarryOut}"
                            Click="CarryOutRequested" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
