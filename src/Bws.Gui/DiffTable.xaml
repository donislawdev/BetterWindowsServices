<UserControl x:Class="Bws.Gui.DiffTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             IsTabStop="False">

    <!--
        THE TABLE UNDER A COMPARISON, AND THE SENTENCE IN ITS PLACE WHEN NOTHING DIFFERS - a part of
        DiffView with a state of its own (rows, or none), so a component of its own from the start: GUI
        rule 9. Bound to the same ViewModels.DiffSheet as the view around it.

        ONE ROW PER FIELD, wearing the list's own styles - GUI rule 2: a table in this window is the
        list's table. Read only, and nothing on it opens a plan: a row here is a fact about two moments,
        not a service somebody can act on.

        Focusable and IsTabStop are off on the UserControl, `docs/10` trap 8 - the grid inside is the
        stop, not the part holding it.

        THE ROWS ARE THE FILTER'S, the empty state is the sheet's (W2-b): the table shows what "Show"
        leaves on screen, and it gives way to the sentence only when the comparison itself found
        nothing - a choice that narrows the rows never makes the comparison say "no differences".
    -->
    <Grid>
        <DataGrid x:Name="Lines"
                  AutomationProperties.AutomationId="diffLines"
                  ItemsSource="{Binding Filter.Rows}"
                  RowStyle="{StaticResource ListRow}"
                  CellStyle="{StaticResource ListCell}"
                  ColumnHeaderStyle="{StaticResource ColumnHeading}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  CanUserReorderColumns="False"
                  CanUserAddRows="False"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{StaticResource SurfaceRowLine}"
                  HeadersVisibility="Column"
                  HorizontalScrollBarVisibility="Auto"
                  SelectionUnit="FullRow"
                  SelectionMode="Extended">
            <DataGrid.Style>
                <Style TargetType="DataGrid" BasedOn="{StaticResource ListGrid}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Lines.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Style>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource gui.diff.column.entry}"
                                    Binding="{Binding ServiceName}"
                                    ElementStyle="{StaticResource CellText}"
                                    Width="Auto" />
                <DataGridTextColumn Header="{DynamicResource gui.column.displayName}"
                                    Binding="{Binding DisplayName}"
                                    ElementStyle="{StaticResource CellText}"
                                    Width="*" />
                <DataGridTextColumn Header="{DynamicResource gui.diff.column.what}"
                                    Binding="{Binding What}"
                                    ElementStyle="{StaticResource CellText}"
                                    Width="Auto" />
                <!-- Headed from the sheet in DiffTable.xaml.cs - "In the snapshot" or "Earlier". -->
                <DataGridTextColumn x:Name="BeforeColumn"
                                    Binding="{Binding Before}"
                                    ElementStyle="{StaticResource CellText}"
                                    Width="*" />
                <DataGridTextColumn x:Name="AfterColumn"
                                    Binding="{Binding After}"
                                    ElementStyle="{StaticResource CellText}"
                                    Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- NOTHING DIFFERS IS A SENTENCE, NOT AN EMPTY TABLE - `docs/11` 3.8. -->
        <TextBlock AutomationProperties.AutomationId="diffSame"
                   Text="{Binding Same}"
                   TextWrapping="Wrap"
                   MaxWidth="{StaticResource WidthOverview}"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Same}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
