<UserControl x:Class="Bws.Gui.HistoryTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             IsTabStop="False">

    <!--
        THE TABLE UNDER THE CHANGE HISTORY, AND THE SENTENCE IN ITS PLACE WHILE THE LOG IS BEING READ OR
        COULD NOT BE - a part of HistoryView with a state of its own, so a component of its own from the
        start: GUI rule 9, and the comparison's DiffTable is the same decision. Bound to the same
        ViewModels.HistorySheet as the view around it.

        ONE LINE PER CHANGE, OR PER GROUP OF IDENTICAL ONES (J2-b), wearing the list's own row, cell and
        heading through ReadOnlyTable. Read only, and nothing on it opens a plan: a line here is what the
        log recorded, not a service somebody can act on - an installation names no entry at all.

        NEWEST FIRST UNTIL SOMEBODY SORTS, AND THE HEADING SAYS SO (AS-d, 2026-10-20): FirstSort lays the
        sort on "At" and its mark with it. BOTH TIME COLUMNS SORT BY THE MOMENT BEHIND THEM SINCE 2026-10-27
        (logic report H04), not by the text: the text is local time without its offset, and in the hour the
        clocks go back it sorts a later change before an earlier one. The count column sorts by the number
        behind it - the text is empty for one, and text puts "9" after "56".

        GONE WHEN NO LINE IS LEFT - an empty log, or a search that finds nothing. The sentences above the
        table say the first, the line beside the search the second (HistoryFilter.Showing).

        Focusable and IsTabStop are off on the UserControl, `docs/10` trap 8 - the grid inside is the stop.
    -->
    <Grid>
        <DataGrid x:Name="Lines"
                  AutomationProperties.AutomationId="historyLines"
                  ItemsSource="{Binding Filter.Rows}">
            <DataGrid.Style>
                <Style TargetType="DataGrid" BasedOn="{StaticResource ReadOnlyTable}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Filter.Rows.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Style>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource gui.history.column.when}"
                                    Binding="{Binding When}"
                                    SortMemberPath="At"
                                    ElementStyle="{StaticResource CellText}"
                                    Width="Auto" />
                <DataGridTextColumn Header="{DynamicResource gui.history.column.times}"
                                    Binding="{Binding Times}"
                                    SortMemberPath="Count"
                                    ElementStyle="{StaticResource CellText}"
                                    Width="Auto" />
                <DataGridTextColumn Header="{DynamicResource gui.history.column.entry}"
                                    Binding="{Binding Entry}"
                                    ElementStyle="{StaticResource CellText}"
                                    Width="Auto" />
                <DataGridTextColumn Header="{DynamicResource gui.history.column.change}"
                                    Binding="{Binding Change}"
                                    ElementStyle="{StaticResource CellText}"
                                    Width="*" />
                <DataGridTextColumn Header="{DynamicResource gui.history.column.by}"
                                    Binding="{Binding By}"
                                    ElementStyle="{StaticResource CellText}"
                                    Width="Auto" />
                <DataGridTextColumn Header="{DynamicResource gui.history.column.since}"
                                    Binding="{Binding Since}"
                                    SortMemberPath="FirstAt"
                                    ElementStyle="{StaticResource CellText}"
                                    Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- READING, OR WHY THE LOG COULD NOT BE READ, IS A SENTENCE, NOT AN EMPTY TABLE - `docs/11` 3.8. -->
        <TextBlock AutomationProperties.AutomationId="historySaid"
                   Text="{Binding Said}"
                   TextWrapping="Wrap"
                   MaxWidth="{StaticResource WidthOverview}"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Said}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
