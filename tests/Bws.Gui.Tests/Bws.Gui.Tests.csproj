<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>

    <!--
      A test project of xUnit.net v3 is a stand-alone executable that can run itself, where one
      of v2 was a library that a runner loaded - the migration guide on xunit.net says so.
    -->
    <OutputType>Exe</OutputType>

    <!--
      The window project is WPF and this one has to be able to load its types. The view model
      itself knows nothing about WPF - that is the point of it - but the assembly it lives in
      does, and the language loader puts strings into a resource dictionary.
    -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <!--
      The same random input library as the core's and the command line's tests, the same version,
      and still never in anything published - ADR-15 says so on its row. It arrives here on
      2026-10-17 for the properties over what the window reads from outside: its own layout file,
      the hand-over between two windows, and the files it exports for a spreadsheet.
    -->
    <PackageReference Include="CsCheck" Version="4.7.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Bws.Tests" />
  </ItemGroup>

  <!--
    Finding the source tree, shared by linking rather than by a shared assembly - the reference
    edges between these projects are themselves under guard. See tests/SourceTree.cs for why
    there is one copy of this and not four.
  -->
  <ItemGroup>
    <Compile Include="..\SourceTree.cs" Link="SourceTree.cs" />

    <!--
      The one door every random property goes through, and the five ways a stored file is damaged,
      both linked for the reason SourceTree.cs is. The weekly search counts calls through the first,
      so a property sampling past it would be searched without anybody knowing how much.
    -->
    <Compile Include="..\Searching.cs" Link="Searching.cs" />
    <Compile Include="..\Damaged.cs" Link="Damaged.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bws.Gui\Bws.Gui.csproj" />
    <ProjectReference Include="..\..\src\Bws.Core\Bws.Core.csproj" />
  </ItemGroup>

</Project>
