<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The command line project, referenced rather than launched.

      Every test that existed for this assembly before 2026-08-04 ran the built executable as a
      SEPARATE PROCESS, which is the right shape for asking what somebody at a terminal sees -
      and the reason a quarter of the shipped code was invisible to any coverage measurement.
      A process nobody instruments reports nothing.

      So this project exists for the other half: the pieces inside that assembly that are
      ordinary code and can be called directly. The integration tests keep the surface, this
      keeps the units.
    -->
    <ProjectReference Include="..\..\src\Bws.Cli\Bws.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      THE FOURTH PROJECT TO LINK THIS FILE RATHER THAN THE FIRST TO REFERENCE A SHARED ONE, and
      the reasoning is written at the top of tests/SourceTree.cs: a shared test assembly would be
      a new reference edge, and the edges between these projects are themselves under guard.

      It arrives here for LicenceCommandTests, which has to read packaging/components.json off
      the disk. Comparing the answer this program gives against the register it was compiled from
      is the only way to catch the one failure that matters there - an executable confidently
      listing the OTHER package's components.
    -->
    <Compile Include="..\SourceTree.cs" Link="SourceTree.cs" />
  </ItemGroup>

</Project>
