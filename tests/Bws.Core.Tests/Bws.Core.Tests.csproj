<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>

    <!--
      A test project of xUnit.net v3 is a stand-alone executable that can run itself, where one
      of v2 was a library that a runner loaded - the migration guide on xunit.net says so.
    -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />

    <!--
      Property tests. ADR-15 in docs/02 carries the argument; the short version is that this
      project already writes them by hand and the one thing it cannot do by hand is shrink a
      failure to the smallest input that causes it.

      Apache-2.0, checked in the project's own LICENSE file rather than on the package label.
      Test projects only, never packed, never published - a guard in the architecture tests
      keeps it out of anything that ships.
    -->
    <PackageReference Include="CsCheck" Version="4.9.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Bws.Tests" />
  </ItemGroup>

  <!--
    The one door the random properties go through, linked rather than referenced for the reason
    SourceTree.cs gives in the other test projects: a shared test assembly would be a new reference
    edge. It counts the draws for the weekly search in tests/search. Beside it, the five ways a
    stored file is damaged, shared with the window's tests that read their own files back.
  -->
  <ItemGroup>
    <Compile Include="..\Searching.cs" Link="Searching.cs" />
    <Compile Include="..\Damaged.cs" Link="Damaged.cs" />
  </ItemGroup>

  <!--
    The kept copy of the snapshot file, embedded under its own name so SnapshotGoldenTests reads the
    exact bytes of the source rather than whatever a copy step left in the output folder.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Golden\snapshot-schema-4.json" LogicalName="snapshot-schema-4.json" />
    <EmbeddedResource Include="Golden\snapshot-schema-5.json" LogicalName="snapshot-schema-5.json" />
    <EmbeddedResource Include="Golden\snapshot-schema-6.json" LogicalName="snapshot-schema-6.json" />
    <EmbeddedResource Include="Golden\snapshot-schema-7.json" LogicalName="snapshot-schema-7.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bws.Core\Bws.Core.csproj" />
  </ItemGroup>

</Project>