<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>

    <!--
      A test project of xUnit.net v3 is a stand-alone executable that can run itself, where one
      of v2 was a library that a runner loaded - the migration guide on xunit.net says so.
    -->
    <OutputType>Exe</OutputType>

    <!--
      Deliberately NOT UseWPF, unlike the window's own test project.

      Turning it on changes which namespaces are imported without being written down - it adds
      the ones WPF needs and drops System.IO - and thirty two lines in this project stopped
      compiling the moment it went in. That is a lot of noise to accept for a setting that is
      not needed: the parity check touches the view model, and the view model knows nothing
      about WPF. That is the entire reason it exists as a layer.

      Which means this project also proves something by building: if the view model ever grows
      a WPF type on its public surface, this stops compiling.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Bws.Tests" />
  </ItemGroup>

  <!--
    Finding the source tree, shared by linking rather than by a shared assembly - the reference
    edges between these projects are themselves under guard. See tests/SourceTree.cs for why
    there is one copy of this and not four.
  -->
  <ItemGroup>
    <Compile Include="..\SourceTree.cs" Link="SourceTree.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bws.Core\Bws.Core.csproj" />

    <!--
      The window, so that one query can be asked of both interfaces and the answers compared.
      This is the only project that references both, and it is a test project - the shipped
      ones are held apart by DeclaredReferenceGuards and stay that way.
    -->
    <ProjectReference Include="..\..\src\Bws.Gui\Bws.Gui.csproj" />
  </ItemGroup>

</Project>