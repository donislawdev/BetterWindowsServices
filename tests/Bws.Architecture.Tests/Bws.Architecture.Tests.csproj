<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <!--
    The C# parser, for the code shape guards and nothing else - CodeShape.cs says what it measures.

    Pinned to the Roslyn the SDK compiler is: 10.0.401 ships 5.9, and a parser older than the
    language the build compiles reads new syntax as errors and counts it wrong without a sound.
    CodeShapeGuards.Every_file_parses_without_a_syntax_error is the canary for exactly that, so
    moving the SDK forward without moving this line turns red with the file named.

    Test-only by construction: this project is IsPackable=false and nothing here is published.
    ADR-15 carries the entry the dependency rule asks for.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Bws.Tests" />
  </ItemGroup>

  <!--
    Finding the source tree, shared by linking rather than by a shared assembly - the reference
    edges between these projects are themselves under guard. See tests/SourceTree.cs for why
    there is one copy of this and not four.
  -->
  <ItemGroup>
    <Compile Include="..\SourceTree.cs" Link="SourceTree.cs" />
  </ItemGroup>

  <!--
    These guards inspect BUILD OUTPUT, not linked assemblies.

    Referencing the guarded projects would defeat the purpose. This project would
    add exactly the kind of reference edge it exists to forbid, and it could not
    inspect Bws.Gui at all, because WPF forces net10.0-windows while the test host
    runs on net10.0.

    ReferenceOutputAssembly="false" keeps the build ordering (guarded projects are
    built first) without creating a compile-time reference.
    SkipGetTargetFrameworkProperties="true" stops MSBuild from negotiating target
    frameworks across the boundary, which is the step that fails for WPF.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Bws.Core\Bws.Core.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\..\src\Bws.Cli\Bws.Cli.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\..\src\Bws.Gui\Bws.Gui.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

</Project>
